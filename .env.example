# Cổng lắng nghe
PORT=8770

# Chế độ chạy: 1 = máy cá nhân (cho phép Ollama và key môi trường), 0 = máy chủ host
LOCAL_MODE=1

# Google PageSpeed Insights API Key (Tuỳ chọn - Miễn phí tại Google Cloud Console)
PAGESPEED_API_KEY=

# Giới hạn lượt kiểm tra SEO mỗi IP mỗi ngày (0 = không giới hạn)
DAILY_LIMIT=5
MAX_PARALLEL_CHECKS=2

# Giới hạn lượt gọi AI mỗi IP mỗi ngày
AI_DAILY_LIMIT=20
MAX_PARALLEL_AI=2

# Thời gian chờ (giây)
FETCH_TIMEOUT_SEC=15
PSI_TIMEOUT_SEC=60
AI_TIMEOUT_SEC=60

# API Keys cho chế độ máy cá nhân (LOCAL_MODE=1)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
